#!/bin/bash

export PID=$$

# Initializing Product Related Details
product_name="UEMS Agent"
product_code="UEMS"

# Initializing Directory Related Details
manageengine_dir_subpath="manageengine"
product_dir_name="manageengine/uems_agent"
product_settings_file="/etc/$product_dir_name/uemsagentsettings.json"

# Initializing Installer,Uninstaller Related Details
installer_name="UEMS_LinuxAgent"
installer_path=$0
uninstaller_name="RemoveUEMSAgent.sh"

function untar_payload() {
  match=$(grep --text --line-number '^::tar::$' $installer_path | cut -d ':' -f 1)
  payload_start=$((match + 1))

  # Extraction Method Changes
  # Old     --> -xzf => gz compression
  # Current --> -xJf => xz compression
  tail -n +$payload_start $installer_path | tar -C $agent_install_directory -xJf - || throw_tar_err
  echo "Extracted the Agent to : $agent_install_directory/$product_dir_name"
}

function throw_tar_err() {
  echo "Upgrade TAR package to the latest version to resume with the installation"
  script_exit
}

function script_exit() {
  echo "$product_name Installation Failed !"
  exit 1
}

function print_install_status() {
  status=$(echo $?)
  case $status in
  "100")
    echo "$product_name UEMS Agent has been Installed Successfully!. Utilize the Agent - Server Troubleshooting tool to verify the connection."
    ;;

  "0" | "61" | "101")
    echo "$product_name has been Installed Successfully!"
    ;;

  "62")
    echo "The UEMS Agent for this machine has been declined by the sysadmin."
    echo "Uninstallation of the agent will be initiated."
    ;;

  "63")
    echo "Sysadmin approval pending. $product_name Installation Successfully!"
    echo "$product_name Installation Successfully!"
    echo "Endpoint is now awaiting Admin Approval from the Server Console."
    ;;

  *)
    script_exit
    ;;
  esac
}

#
# -- PREINSTALL CHECKS GOES HERE ............
#

# Ensure the Script is Run as Root.

if [ "$EUID" -ne 0 ]; then
  echo "$product_name Installation Failed! - Retry Agent Installation with \"Root Permission\""
  exit 1
fi

upgrade_agent=false
force_install=false

while getopts "d:u:a:fs" option; do
  case $option in
  d)
    directory_to_install=$OPTARG
    #echo "Received Option to Change Install Directory : $directory_to_install"
    if [ ! -e $directory_to_install ]; then
      echo "Invalid location provided. Will revert to default location."
    fi
    ;;
  u)
    #echo "Received Option to Upgrade Agent"
    upgrade_agent=true
    new_agent_version=$OPTARG
    ;;
  f)
    # Force installation, even if agent already exists.
    force_install=true
    ;;
  a)
    # Domain Name details are provided as argument.
    domainname=$OPTARG
    ;;
  s)
    # Define Server License here
    isServerLicenseEnabled=true
    ;;
  \?)
    echo "If you wanted to specify the path of the directory, use \"-d <directory_path>\""
    script_exit
    ;;
  esac
done

# Check the Existence of Property File in the Same Directory.

if [ "$upgrade_agent" == false ]; then
  if [ ! -e serverinfo.json ]; then
    echo "$product_name Installation Failed! Missing : \"serverinfo.json\" file - Ensure the \"serverinfo.json\" & \"$installer_name.bin\" are in the same location."
    exit 1
  fi

  if [ -s serverinfo.json ]; then
    echo "ServerInfo File Exists. Proceeding with Installation."
  else
    echo "$product_name Installation Failed! - \"serverinfo.json\" is empty. Please re-download the agent."
    exit 1
  fi

else
  if [ -e serverinfo.json ]; then
    if [ -s serverinfo.json ]; then
      echo "ServerInfo File Exists. Proceeding with Installation."
    else
      echo "$product_name Installation Failed! - \"serverinfo.json\" is empty. Please re-download the agent."
      exit 1
    fi
  else
    echo "$product_name Installation Failed! - Ensure the \"serverinfo.json\" & \"$installer_name.bin\" are in the same location."
    exit 1
  fi
fi

# $agent_install_directory containing $product_dir_name (For example, /usr/local/manageengine/uems_agent) will be taken here
#
if [ -e $product_settings_file ]; then
  agent_install_directory=$(cat $product_settings_file | grep "DIRECTORY_PATH" | cut -f 2 -d ":" | cut -f 2 -d "\"")
elif [ -e /etc/uems_agent/uemsagentsettings.json ]; then
  product_settings_file="/etc/uems_agent/uemsagentsettings.json"
  agent_install_directory=$(cat $product_settings_file | grep "DIRECTORY_PATH" | cut -f 2 -d ":" | cut -f 2 -d "\"")
elif [ -e /etc/desktopcentralagent/dcagentsettings.json ]; then
  product_settings_file="/etc/desktopcentralagent/dcagentsettings.json"
  agent_install_directory=$(cat $product_settings_file | grep "DIRECTORY_PATH" | cut -f 2 -d ":" | cut -f 2 -d "\"")
fi

#Removing $product_dir_name from $agent_install_directory (For example, /usr/local/) for extracting agent files to parent agent install directory
#
if [[ -e $agent_install_directory && $agent_install_directory =~ $product_dir_name ]]; then
  # If agent_install_directory contains manageengine/uems_agent, remove last two subpath
  # (For example, /usr/local/ from /usr/local/manageengine/uems_agent)
  agent_install_directory=$(echo "$agent_install_directory" | rev | cut -f 1,2 -d "/" --complement | rev)
else
  # If agent_install_directory does not contains manageengine/uems_agent, remove last subpath
  # (For example, /usr/local/ from /usr/local/uems_agent)
  agent_install_directory=$(echo "$agent_install_directory" | rev | cut -f 1 -d "/" --complement | rev)
fi

# If, still $agent_install_directory does not exist, make an attempt to take $agent_install_directory from either exe symlink, systemctl service or init.d service file
# $agent_install_directory containing $product_dir_name (For example, /usr/local/manageengine/uems_agent) will be taken here
#
if [[ ! -e $agent_install_directory ]]; then
  if [ -e /usr/bin/dcservice ]; then
    agent_install_directory=$(ls -l /usr/bin/ | grep dcservice | cut -d ">" -f 2 | rev | cut -f 1,2 -d "/" --complement | rev)
  elif [ -e /etc/systemd/system/dcservice.service ]; then
    agent_install_directory=$(cat /etc/systemd/system/dcservice.service | grep "dcservice -t" | cut -d " " -f 1 | cut -d "=" -f 2 | rev | cut -d "/" -f 1,2 --complement | rev)
  elif [ -e /etc/init.d/dcservice ]; then
    agent_install_directory=$(cat /etc/init.d/dcservice | grep "dcservice -p" | cut -d "-" -f 1 | rev | cut -d "/" -f 3- | rev)
  fi

  #Removing $product_dir_name from $agent_install_directory for extracting agent files to parent agent install directory
  #
  if [[ -e $agent_install_directory && $agent_install_directory =~ $product_dir_name ]]; then
    # If $agent_install_directory contains manageengine/uems_agent, remove last two subpath
    # (For example, /usr/local/ from /usr/local/manageengine/uems_agent)
    agent_install_directory=$(echo "$agent_install_directory" | rev | cut -f 1,2 -d "/" --complement | rev)
  else
    # If $agent_install_directory does not contains manageengine/uems_agent, remove last subpath
    # (For example, /usr/local/ from /usr/local/uems_agent)
    agent_install_directory=$(echo "$agent_install_directory" | rev | cut -f 1 -d "/" --complement | rev)
  fi
fi

if [[ ! -e $agent_install_directory ]]; then
  if [[ -e $directory_to_install ]]; then
    # rstrip trailing "/"
    agent_install_directory=$(echo $directory_to_install | sed -e 's/\/\+$//')
  else
    agent_install_directory="/usr/local" # Default Agent Install Directory
  fi
fi

# Uninstalling existing Agent. For Upgrade.

if [ -e /etc/systemd/system/dcservice.service ] || [ -e /etc/init.d/dcservice ]; then

  existing_product_code=$(cat $product_settings_file | grep "PRODUCT_CODE" | cut -f 2 -d ":" | cut -f 2 -d "\"" | rev | cut -f 1 -d "/" --complement | rev)
  existing_agent_dir=$(cat $product_settings_file | grep "DIRECTORY_PATH" | cut -f 2 -d ":" | cut -f 2 -d "\"")
  remove_old_agent=false

  if [[ existing_agent_dir =~ $manageengine_dir_subpath ]]; then
    existing_agent_dir=$(echo "$existing_agent_dir" | rev | cut -f 1,2 -d "/" --complement | rev)
    existing_product_dir="manageengine/uems_agent"
    uninstaller_name="RemoveUEMSAgent.sh"
  else
    existing_agent_dir=$(echo "$existing_agent_dir" | rev | cut -f 1 -d "/" --complement | rev)
    if [ "$existing_product_code" == "DC" ]; then
      existing_product_dir="desktopcentralagent"
      uninstaller_name="RemoveDCAgent.sh"
    elif [ "$existing_product_code" == "PMP" ]; then
      existing_product_dir="pmpagent"
      uninstaller_name="RemovePMPAgent.sh"
    elif [ "$existing_product_code" == "RAP" ] || [ "$existing_product_code" == "rapagent" ]; then
      existing_product_dir="rapagent"
      uninstaller_name="RemoveRAPAgent.sh"
    else
      existing_product_dir="uems_agent"
      uninstaller_name="RemoveUEMSAgent.sh"
    fi
  fi

  if [ "$upgrade_agent" == false ]; then
    # For Manual Agent Installation
    #
    # Determining the Directory to Install the New Agent
    #
    if [[ -e $directory_to_install ]]; then
      # rstrip trailing "/"
      agent_install_directory=$(echo "$directory_to_install" | sed -e 's/\/\+$//')
    else
      agent_install_directory="/usr/local" # Default Agent Install Directory
    fi
    echo "Agent Already Installed."

    # Request user input on how to proceed:
    # 1. Remove old agent and install new
    # 2. Abort the current installation
    #

    if [ "$force_install" == false ]; then
      while true; do
        read -p "Do you want to uninstall the existing agent and re-install this agent? (y/n) : " proceed
        case $proceed in
        [nN]*)
          echo "This process is aborted, no changes are done to the existing agent."
          exit 0
          ;;
        [yY]*)
          remove_old_agent=true
          break
          ;;
        *) echo "Invalid Entry." ;;
        esac
      done
    else
      echo "Proceeding with force installation."
      remove_old_agent=true
    fi

  elif [[ ("$existing_product_code" != "") && ("$existing_product_code" != "$product_code") ]] || [[ ("$existing_agent_dir" != "") && (! "$existing_agent_dir" =~ "$manageengine_dir_subpath") ]]; then

    # For Agent Upgradation 1. when existing and new agent are of different products 2. when the existing directory does not contains manageengine subpath

    # 1. Stop the existing agent service to ensure no interruption while copying
    #
    "$existing_agent_dir/$existing_product_dir/bin/dcservice" -p

    # 2. Copy the old agent directory contents to the new one
    #
    echo "Copying $existing_product_code files to $product_code"
    mkdir -p "$agent_install_directory/$product_dir_name/"

    cp -fr "$existing_agent_dir/$existing_product_dir/data" "$agent_install_directory/$product_dir_name/"
    cp -fr "$existing_agent_dir/$existing_product_dir/conf" "$agent_install_directory/$product_dir_name/"
    cp -fr "$existing_agent_dir/$existing_product_dir/logs" "$agent_install_directory/$product_dir_name/"
    cp -fr "$existing_agent_dir/$existing_product_dir/updates" "$agent_install_directory/$product_dir_name/"
    cp -fr "$existing_agent_dir/$existing_product_dir/SupportUploadTask" "$agent_install_directory/$product_dir_name/"

    if [[ -f "$existing_agent_dir/$existing_product_dir/bin/dcrhyumcache" ]]; then
      echo "Copying dcrhyumcache."
      mkdir -p "$agent_install_directory/$product_dir_name/bin/"
      cp -f "$existing_agent_dir/$existing_product_dir/bin/dcrhyumcache" "$agent_install_directory/$product_dir_name/bin/dcrhyumcache"
    fi

    # 3. Set the flag to uninstall/remove the existing agent
    #
    remove_old_agent=true
    cd $agent_install_directory/$product_dir_name/updates

    # 4. Set the installer_path to the new agent's directory (to ensure that it is not deleted during agent uninstallation)
    #
    installer_path="$agent_install_directory/$product_dir_name/updates/$installer_name.bin"
  fi

  if [[ "$remove_old_agent" == true ]]; then
    # Uninstallation of old agent will be done for both:
    # 1. Upgradation when the existing and new agent are of different products.
    # 2. Manual agent installation with user selecting to replace old agent.

    # Uninstalling the old agent
    #
    if [ ! -f "$existing_agent_dir/$existing_product_dir/$uninstaller_name" ]; then
      uninstaller_name="RemoveUEMSAgent.sh"
    fi
    chmod +x "$existing_agent_dir/$existing_product_dir/$uninstaller_name"
    echo "Uninstalling Existing Version of Agent"
    "$existing_agent_dir/$existing_product_dir/$uninstaller_name" migration || script_exit

    # Old agent directory removal is applicable only
    # For Migrated agents, Force agent installation
    # Doesn't delete old agent directory

    # Proceed with unpacking the New Agent
    #
    echo "Unpacking the New Agent"
  fi
fi

#os_flavour = $(uname )

if [[ ! -e "$agent_install_directory/$product_dir_name" ]]; then
  mkdir -p "$agent_install_directory/$product_dir_name"
fi

untar_payload || script_exit #   Extracting the archive

#removing RemoveDCagent.sh if exist as it is not needed here after UEMS name change
if [ -f "$agent_install_directory/$product_dir_name/RemoveDCAgent.sh" ]; then
  rm -fr "$agent_install_directory/$product_dir_name/RemoveDCAgent.sh"
fi

#
# -- POSTINSTALL CHECKS GOES HERE ............
#

if [[ ! -e "$agent_install_directory/$product_dir_name/logs" ]]; then
  mkdir -p "$agent_install_directory/$product_dir_name/logs"
fi

if [[ ! -e "$agent_install_directory/$product_dir_name/data/certificates" ]]; then
  mkdir -p "$agent_install_directory/$product_dir_name/data/certificates"
fi

if [[ ! -e "$agent_install_directory/$product_dir_name/conf" ]]; then
  mkdir -p "$agent_install_directory/$product_dir_name/conf"
fi

if [[ ! -e "$agent_install_directory/$product_dir_name/updates" ]]; then
  mkdir -p "$agent_install_directory/$product_dir_name/updates"
fi

echo "Agent Registration is in progress, this might take few minutes..."

if [[ "$isServerLicenseEnabled" == true ]]; then
  echo "{\"isServerOS\":\"true\"}" > "$agent_install_directory/$product_dir_name/data/agent-local-settings.json"
fi

# Performing Install / Upgrade Tasks.
#
if [ "$upgrade_agent" == false ]; then
  # Installation case
  #
  # Copying the latest serverinfo.json file to the 'conf/' directory
  #
  cp serverinfo.json "$agent_install_directory/$product_dir_name/conf/ServerInfo.json"
  cp serverinfo.json "$agent_install_directory/$product_dir_name/conf/DupServerInfo.json"

  if [ ! -z "$domainname" ]; then
    $agent_install_directory/$product_dir_name/bin/dcregister install "$agent_install_directory/$product_dir_name" $product_code "$domainname"
    print_install_status

  else
    $agent_install_directory/$product_dir_name/bin/dcregister install "$agent_install_directory/$product_dir_name" $product_code
    print_install_status
  fi

else
  # Upgradation cases
  #

  # Copying the latest serverinfo.json file from the 'updates/' directory to 'conf/'
  #
  cp "$agent_install_directory/$product_dir_name/updates/serverinfo.json" "$agent_install_directory/$product_dir_name/conf/ServerInfo.json"
  cp "$agent_install_directory/$product_dir_name/updates/serverinfo.json" "$agent_install_directory/$product_dir_name/conf/DupServerInfo.json"
  if [ -e DMRootCA.crt ]; then
    cp -f "$agent_install_directory/$product_dir_name/updates/DMRootCA.crt" "$agent_install_directory/$product_dir_name/data/certificates/DMRootCA.crt"
  fi
  if [ -e DMRootCA-Server.crt ]; then
    cp -f "$agent_install_directory/$product_dir_name/updates/DMRootCA-Server.crt" "$agent_install_directory/$product_dir_name/data/certificates/DMRootCA-Server.crt"
  fi

  # In this corresponding release, CollectLogs.sh will be moved to $agent_install_directory, so removing old CollectLogs.sh if present in logs/
  if [[ -e "$existing_agent_dir/$existing_product_dir/logs/CollectLogs.sh" ]]; then
    rm -fr "$existing_agent_dir/$existing_product_dir/logs/CollectLogs.sh"
  fi

  if [[ ("$existing_product_code" != "") && ("$existing_product_code" != "$product_code") ]] || [[ ("$existing_agent_dir" != "") && (! "$existing_agent_dir" =~ "$manageengine_dir_subpath") ]]; then

    # De-Registering Old Scheduler for dcagentupgrader. And adding new one.
    #
    cat /etc/crontab | grep -v dcagentupgrader >>/etc/crontab_temp
    cp /etc/crontab_temp /etc/crontab
    rm /etc/crontab_temp
    echo "0 */2 * * * root $agent_install_directory/$product_dir_name/bin/dcagentupgrader" >>/etc/crontab
    # Adding 1hr cron for upload scheduler
    echo "0 */2 * * * root $agent_install_directory/$product_dir_name/bin/dcuiactionhandler -run upload-logs-root -action refresh-upload" >>/etc/crontab

    # Installing the new product's agent
    #
    echo "Installing $product_code Agent"
    if [ ! -z "$domainname" ]; then
      $agent_install_directory/$product_dir_name/bin/dcregister install "$agent_install_directory/$product_dir_name" $product_code "$domainname"
      print_install_status
    else
      $agent_install_directory/$product_dir_name/bin/dcregister install "$agent_install_directory/$product_dir_name" $product_code
      print_install_status
    fi

    # Removing the old agent directory
    #
    rm -fr "${existing_agent_dir:?}/${existing_product_dir:?}/"

  else
    # If it is the upgrade of the same product's agent
    #
    echo "Upgrading Agent"
    if [ ! -z "$domainname" ]; then
      $agent_install_directory/$product_dir_name/bin/dcregister upgrade $new_agent_version $product_code "$domainname" || script_exit

    else
      $agent_install_directory/$product_dir_name/bin/dcregister upgrade $new_agent_version || script_exit
    fi

  fi
fi

# Registering Scheduler for dcagentupgrader
#
if [ "$upgrade_agent" == false ]; then
  cat /etc/crontab | grep -v dcagentupgrader | grep -v dcsupportscheduler >>/etc/crontab_temp
  cp /etc/crontab_temp /etc/crontab
  rm /etc/crontab_temp
  echo "0 */1 * * * root $agent_install_directory/$product_dir_name/bin/dcagentupgrader" >>/etc/crontab
  # Adding 2hr cron for log upload scheduler
  echo "0 */2 * * * root $agent_install_directory/$product_dir_name/bin/dcuiactionhandler -run upload-logs-root -action refresh-upload" >>/etc/crontab
fi

exit 0
